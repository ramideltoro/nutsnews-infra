logging {
  level  = sys.env("NUTSNEWS_ALLOY_LOG_LEVEL")
  format = "logfmt"
}

prometheus.remote_write "grafana_cloud" {
  external_labels = {
    service_namespace      = "nutsnews",
    deployment_environment = sys.env("NUTSNEWS_ALLOY_ENVIRONMENT"),
    env                    = sys.env("NUTSNEWS_ALLOY_ENVIRONMENT"),
    instance               = sys.env("NUTSNEWS_ALLOY_HOSTNAME"),
    host                   = sys.env("NUTSNEWS_ALLOY_HOSTNAME"),
  }

  endpoint {
    url = sys.env("GRAFANA_CLOUD_METRICS_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_METRICS_USERNAME")
      password = sys.env("GRAFANA_CLOUD_ACCESS_POLICY_TOKEN")
    }
  }
}

loki.write "grafana_cloud" {
  max_streams = 500
  external_labels = {
    deployment_environment = sys.env("NUTSNEWS_ALLOY_ENVIRONMENT"),
    host                   = sys.env("NUTSNEWS_ALLOY_HOSTNAME"),
  }

  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOGS_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOGS_USERNAME")
      password = sys.env("GRAFANA_CLOUD_ACCESS_POLICY_TOKEN")
    }
  }
}

prometheus.exporter.unix "host" {
  include_exporter_metrics = true
  enable_collectors        = ["processes", "systemd"]

  filesystem {
    fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
    mount_points_exclude = "^/(dev|proc|run/credentials/.+|sys|var/lib/docker/.+|var/lib/containers/.+)($|/)"
  }

  netdev {
    device_exclude = "^(br-.*|docker.*|lo|veth.*)$"
  }

  systemd {
    enable_restarts = true
    start_time      = true
    task_metrics    = true
    unit_include    = "^(alloy|ssh|docker|systemd-timesyncd|unattended-upgrades|ufw|fail2ban|nutsnews-.+)\\.(service|timer)$"
  }

  textfile {
    directory = "{{ vps_service_foundation_grafana_alloy_textfile_dir }}"
  }
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  job_name        = "integrations/node_exporter"
  scrape_interval = "{{ vps_service_foundation_grafana_alloy_scrape_interval }}"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.relabel.host_identity.receiver]
}

prometheus.relabel "host_identity" {
  forward_to = [prometheus.relabel.cost_controls.receiver]

  rule {
    source_labels = ["service"]
    regex         = "^$"
    target_label  = "service"
    replacement   = "host-exporter"
  }
}

{% if vps_service_foundation_grafana_alloy_collect_docker | bool %}
prometheus.exporter.cadvisor "containers" {
  docker_host = "{{ vps_service_foundation_grafana_alloy_docker_socket }}"
  docker_only = true

  store_container_labels      = false
  allowlisted_container_labels = [
    "com.docker.compose.project",
    "com.docker.compose.service",
  ]

  storage_duration = "2m"
}

prometheus.scrape "containers" {
  targets         = prometheus.exporter.cadvisor.containers.targets
  job_name        = "integrations/nutsnews-vps-containers"
  scrape_interval = "{{ vps_service_foundation_grafana_alloy_scrape_interval }}"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.relabel.cost_controls.receiver]
}
{% endif %}

prometheus.scrape "alloy" {
  targets = [{
    __address__ = "127.0.0.1:12345",
    instance    = sys.env("NUTSNEWS_ALLOY_HOSTNAME"),
  }]
  job_name        = "integrations/nutsnews-vps-alloy"
  scrape_interval = "{{ vps_service_foundation_grafana_alloy_scrape_interval }}"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.relabel.alloy_identity.receiver]
}

prometheus.relabel "alloy_identity" {
  forward_to = [prometheus.relabel.cost_controls.receiver]

  // Retain only the collector health, remote-write, and Loki delivery families
  // used by production dashboards and alerts. Internal controller histograms
  // and graph labels consume series without improving incident decisions.
  rule {
    source_labels = ["__name__"]
    regex         = "^(up|scrape_(duration_seconds|samples_scraped|samples_post_metric_relabeling|series_added)|alloy_build_info|alloy_config_(last_load_successful|last_load_success_timestamp_seconds|load_failures_total)|prometheus_remote_storage_(samples_(pending|failed_total|retries_total|retried_total|total)|enqueue_retries_total|queue_highest_sent_timestamp_seconds)|prometheus_remote_write_wal_(out_of_order_samples_total|storage_active_series)|loki_write_(dropped_entries_total|dropped_bytes_total|batch_retries_total|sent_entries_total)|loki_process_dropped_lines(_by_label)?_total)$"
    action        = "keep"
  }

  rule {
    target_label = "service"
    replacement  = "alloy"
  }
}

prometheus.scrape "caddy" {
  targets = [{
    __address__ = "{{ vps_service_foundation_grafana_alloy_caddy_metrics_address }}",
    instance    = sys.env("NUTSNEWS_ALLOY_HOSTNAME"),
  }]
  job_name        = "integrations/nutsnews-vps-caddy"
  scrape_interval = "{{ vps_service_foundation_grafana_alloy_scrape_interval }}"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.relabel.caddy_identity.receiver]
}

prometheus.relabel "caddy_identity" {
  forward_to = [prometheus.relabel.cost_controls.receiver]

  rule {
    target_label = "service"
    replacement  = "caddy"
  }

  rule {
    action        = "drop"
    source_labels = ["__name__"]
    regex         = "^(go_.*|process_.*|caddy_admin_.*)$"
  }

  // Per-client rate-limit keys are unbounded and their processing histogram is
  // not an operational SLI. Request/response size and duplicate response-time
  // histograms are also excluded; terminal request rate, status ratios,
  // request latency, upstream errors, and upstream health remain available.
  rule {
    action        = "drop"
    source_labels = ["__name__"]
    regex         = "^(caddy_rate_limit_.*|caddy_http_(request|response)_size_bytes_.*|caddy_http_response_duration_seconds_.*)$"
  }
}

prometheus.relabel "cost_controls" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  rule {
    action = "labeldrop"
    regex  = "^(id|container_id|image_id|container_label_com_docker_compose_config_hash|container_label_com_docker_compose_project_config_files|container_label_com_docker_compose_project_working_dir)$"
  }

  rule {
    action        = "drop"
    source_labels = ["__name__"]
    regex         = "^(go_memstats_.*|process_(cpu|resident|virtual).*|prometheus_target_scrape_pool_.*)$"
  }
}

loki.relabel "journal_labels" {
  forward_to = []

  rule {
    source_labels = ["__journal_priority"]
    regex         = "^[0-2]$"
    replacement   = "critical"
    target_label  = "severity"
  }

  rule {
    source_labels = ["__journal_priority"]
    regex         = "^3$"
    replacement   = "error"
    target_label  = "severity"
  }

  rule {
    source_labels = ["__journal_priority"]
    regex         = "^4$"
    replacement   = "warning"
    target_label  = "severity"
  }

  rule {
    source_labels = ["__journal_priority"]
    regex         = "^[5-6]$"
    replacement   = "info"
    target_label  = "severity"
  }

  rule {
    source_labels = ["__journal_priority"]
    regex         = "^7$"
    replacement   = "debug"
    target_label  = "severity"
  }

}

{% for journal_unit in vps_service_foundation_grafana_alloy_journal_units %}
loki.source.journal "unit_{{ journal_unit | regex_replace('[^A-Za-z0-9_]', '_') }}" {
  matches       = "_SYSTEMD_UNIT={{ journal_unit }}"
  max_age       = "2h"
  relabel_rules = loki.relabel.journal_labels.rules
  labels = {
    service         = "{{ journal_unit | regex_replace('\\.(service|timer)$', '') }}",
{% if journal_unit.startswith('nutsnews-') %}
    service_version = sys.env("NUTSNEWS_ALLOY_SERVICE_VERSION"),
{% else %}
    service_version = "unknown",
{% endif %}
    source          = "journal",
  }
  forward_to = [loki.process.journal.receiver]
}
{% endfor %}

loki.process "journal" {
  forward_to = [loki.write.grafana_cloud.receiver]

  stage.replace {
    expression = "(?i)bearer\\s+([A-Za-z0-9._~+/=-]+)"
    replace    = "[redacted]"
  }

  stage.replace {
    expression = "(?i)(?:password|passwd|token|secret|authorization|proxy[_-]?authorization|credential|api[_-]?key|x[_-]?api[_-]?key)[\"']?\\s*[:=]\\s*(\\[[^\\]]*\\])"
    replace    = "[\\\"[redacted]\\\"]"
  }

  stage.replace {
    expression = "(?i)(?:password|passwd|token|secret|authorization|proxy[_-]?authorization|credential|api[_-]?key|x[_-]?api[_-]?key)[\"']?\\s*[:=]\\s*[\"']([^\"']*)"
    replace    = "[redacted]"
  }

  stage.replace {
    expression = "(?i)(?:authorization|proxy[_-]?authorization)[\"']?\\s*[:=]\\s*(?:basic|digest|bearer|token)\\s+([^\\s,}\\]]+)"
    replace    = "[redacted]"
  }

  stage.replace {
    expression = "(?i)(?:password|passwd|token|secret|authorization|proxy[_-]?authorization|credential|api[_-]?key|x[_-]?api[_-]?key)=([^\\s,]+)"
    replace    = "[redacted]"
  }

  stage.replace {
    expression = "(?i)(?:password|passwd|token|secret|authorization|proxy[_-]?authorization|credential|api[_-]?key|x[_-]?api[_-]?key)\\s*:\\s*([^,\\s]+)"
    replace    = "[redacted]"
  }

  stage.replace {
    expression = "(\\?[^\"\\s]*)"
    replace    = "?[query-redacted]"
  }

  stage.replace {
    expression = "((?:[0-9]{1,3}\\.){3}[0-9]{1,3})"
    replace    = "[ip]"
  }

  stage.drop {
    longer_than         = "8KB"
    drop_counter_reason = "journal_line_too_large"
  }

  stage.match {
    selector            = "{severity=\"debug\"}"
    action              = "drop"
    drop_counter_reason = "journal_debug"
  }

  stage.limit {
    rate                = {{ vps_service_foundation_grafana_alloy_journal_log_rate }}
    burst               = {{ vps_service_foundation_grafana_alloy_journal_log_burst }}
    drop                = true
    by_label_name       = "service"
    max_distinct_labels = 64
  }

  stage.label_keep {
    values = ["deployment_environment", "service", "service_version", "host", "source", "severity"]
  }
}

loki.source.file "nutsnews_files" {
  targets = [
    {
      __path__           = "/var/log/auth.log",
      __path_exclude__   = "/var/log/*.gz",
      job                = "auth-log",
      log_source         = "auth",
      service            = "auth",
      service_version    = "host",
      source             = "auth",
    },
    {
      __path__           = "{{ vps_service_foundation_backup_log_dir }}/*.{log,jsonl}",
      __path_exclude__   = "{{ vps_service_foundation_logs_dir }}/**/*.{gz,zip,bak,old}",
      service            = "backup",
      service_version    = sys.env("NUTSNEWS_ALLOY_SERVICE_VERSION"),
      source             = "file",
    },
    {
      __path__           = "{{ vps_service_foundation_caddy_logs_dir }}/*.{log,jsonl}",
      __path_exclude__   = "{{ vps_service_foundation_logs_dir }}/**/*.{gz,zip,bak,old}",
      service            = "caddy",
      service_version    = "{{ vps_service_foundation_grafana_alloy_caddy_service_version }}",
      source             = "file",
    },
    {
      __path__           = "{{ vps_service_foundation_infra_health_log_dir }}/*.{log,jsonl}",
      __path_exclude__   = "{{ vps_service_foundation_logs_dir }}/**/*.{gz,zip,bak,old}",
      service            = "infra-health",
      service_version    = sys.env("NUTSNEWS_ALLOY_SERVICE_VERSION"),
      source             = "file",
    },
    {
      __path__           = "{{ vps_service_foundation_collector_log_dir }}/*.{log,jsonl}",
      __path_exclude__   = "{{ vps_service_foundation_logs_dir }}/**/*.{gz,zip,bak,old}",
      service            = "ops-portal",
      service_version    = sys.env("NUTSNEWS_ALLOY_SERVICE_VERSION"),
      source             = "file",
    },
    {
      __path__           = "{{ vps_service_foundation_docker_cleanup_log_dir }}/*.{log,jsonl}",
      __path_exclude__   = "{{ vps_service_foundation_logs_dir }}/**/*.{gz,zip,bak,old}",
      service            = "docker-cleanup",
      service_version    = sys.env("NUTSNEWS_ALLOY_SERVICE_VERSION"),
      source             = "file",
    },
    {
      __path__           = "{{ vps_service_foundation_nutsnews_staging_auto_idle_log_dir }}/*.{log,jsonl}",
      __path_exclude__   = "{{ vps_service_foundation_logs_dir }}/**/*.{gz,zip,bak,old}",
      service            = "staging-auto-idle",
      service_version    = sys.env("NUTSNEWS_ALLOY_SERVICE_VERSION"),
      source             = "file",
    },
  ]
  tail_from_end = true
  forward_to    = [loki.process.files.receiver]

  file_match {
    enabled           = true
    sync_period       = "1m"
    ignore_older_than = "168h"
  }
}

loki.process "files" {
  forward_to = [loki.write.grafana_cloud.receiver]

  stage.json {
    expressions = {
      timestamp          = "timestamp",
      level              = "level",
      parsed_severity    = "severity",
      component          = "component",
      request_id         = "request_id",
      message_id         = "message_id",
      correlation_id     = "correlation_id",
      traceparent        = "traceparent",
      trace_id           = "trace_id",
      article_id         = "article_id",
      feed_id            = "feed_id",
      idempotency_key    = "idempotency_key",
      method             = "method",
      status             = "status",
      path               = "path",
      duration_ms        = "duration_ms",
    }
    drop_malformed = false
  }

  stage.template {
    source   = "severity"
{% raw %}
    template = "{{ if .parsed_severity }}{{ ToLower .parsed_severity }}{{ else if .level }}{{ ToLower .level }}{{ else }}unknown{{ end }}"
{% endraw %}

  }

  stage.template {
    source   = "severity"
{% raw %}
    template = "{{ $s := .Value }}{{ if or (eq $s \"trace\") (eq $s \"debug\") }}debug{{ else if or (eq $s \"info\") (eq $s \"notice\") }}info{{ else if or (eq $s \"warn\") (eq $s \"warning\") }}warning{{ else if or (eq $s \"err\") (eq $s \"error\") }}error{{ else if or (eq $s \"fatal\") (eq $s \"critical\") (eq $s \"crit\") (eq $s \"alert\") (eq $s \"emerg\") (eq $s \"emergency\") }}critical{{ else }}unknown{{ end }}"
{% endraw %}
  }

  stage.labels {
    values = {
      severity = "",
    }
  }

  stage.replace {
    source     = "path"
    expression = "(\\?.*)"
    replace    = ""
  }

  stage.structured_metadata {
    values = {
      timestamp       = "",
      component       = "",
      request_id      = "",
      message_id      = "",
      correlation_id  = "",
      traceparent     = "",
      trace_id        = "",
      article_id      = "",
      feed_id         = "",
      idempotency_key = "",
      method          = "",
      status          = "",
      path            = "",
      duration_ms     = "",
    }
  }

  stage.replace {
    expression = "(?i)bearer\\s+([A-Za-z0-9._~+/=-]+)"
    replace    = "[redacted]"
  }

  stage.replace {
    expression = "(?i)(?:password|passwd|token|secret|authorization|proxy[_-]?authorization|credential|api[_-]?key|x[_-]?api[_-]?key)[\"']?\\s*[:=]\\s*(\\[[^\\]]*\\])"
    replace    = "[\\\"[redacted]\\\"]"
  }

  stage.replace {
    expression = "(?i)(?:password|passwd|token|secret|authorization|proxy[_-]?authorization|credential|api[_-]?key|x[_-]?api[_-]?key)[\"']?\\s*[:=]\\s*[\"']([^\"']*)"
    replace    = "[redacted]"
  }

  stage.replace {
    expression = "(?i)(?:authorization|proxy[_-]?authorization)[\"']?\\s*[:=]\\s*(?:basic|digest|bearer|token)\\s+([^\\s,}\\]]+)"
    replace    = "[redacted]"
  }

  stage.replace {
    expression = "(?i)(?:password|passwd|token|secret|authorization|proxy[_-]?authorization|credential|api[_-]?key|x[_-]?api[_-]?key)=([^\\s,]+)"
    replace    = "[redacted]"
  }

  stage.replace {
    expression = "(?i)(?:password|passwd|token|secret|authorization|proxy[_-]?authorization|credential|api[_-]?key|x[_-]?api[_-]?key)\\s*:\\s*([^,\\s]+)"
    replace    = "[redacted]"
  }

  stage.replace {
    expression = "(\\?[^\"\\s]*)"
    replace    = "?[query-redacted]"
  }

  stage.replace {
    expression = "((?:[0-9]{1,3}\\.){3}[0-9]{1,3})"
    replace    = "[ip]"
  }

  stage.match {
    selector            = "{severity=\"debug\"}"
    action              = "drop"
    drop_counter_reason = "file_debug"
  }

  stage.drop {
    longer_than         = "8KB"
    drop_counter_reason = "file_line_too_large"
  }

  stage.limit {
    rate                = {{ vps_service_foundation_grafana_alloy_file_log_rate }}
    burst               = {{ vps_service_foundation_grafana_alloy_file_log_burst }}
    drop                = true
    by_label_name       = "service"
    max_distinct_labels = 8
  }

  stage.label_keep {
    values = ["deployment_environment", "service", "service_version", "host", "source", "severity"]
  }
}

{% if vps_service_foundation_grafana_alloy_collect_docker_logs | bool %}
discovery.docker "containers" {
  host             = "{{ vps_service_foundation_grafana_alloy_docker_socket }}"
  refresh_interval = "60s"

  filter {
    name = "label"
    values = [
{% for compose_project in vps_service_foundation_grafana_alloy_docker_log_compose_projects %}
      "com.docker.compose.project={{ compose_project }}",
{% endfor %}
    ]
  }
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "^({{ vps_service_foundation_grafana_alloy_docker_log_compose_projects | join('|') }})$"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project", "__meta_docker_container_label_com_docker_compose_service"]
    separator     = ";"
    regex         = "^(nutsnews-service-foundation;(caddy|ops-auth)|nutsnews-app;nutsnews-app)$"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    replacement   = "$1"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project", "__meta_docker_container_label_com_docker_compose_service"]
    separator     = ";"
    regex         = "^nutsnews-service-foundation;caddy$"
    replacement   = "caddy"
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project", "__meta_docker_container_label_com_docker_compose_service"]
    separator     = ";"
    regex         = "^nutsnews-service-foundation;ops-auth$"
    replacement   = "ops-auth"
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project", "__meta_docker_container_label_com_docker_compose_service"]
    separator     = ";"
    regex         = "^nutsnews-app;nutsnews-app$"
    replacement   = "web"
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project", "__meta_docker_container_label_com_docker_compose_service"]
    separator     = ";"
    regex         = "^nutsnews-service-foundation;caddy$"
    replacement   = "{{ vps_service_foundation_grafana_alloy_caddy_service_version }}"
    target_label  = "service_version"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project", "__meta_docker_container_label_com_docker_compose_service"]
    separator     = ";"
    regex         = "^nutsnews-service-foundation;ops-auth$"
    replacement   = "{{ vps_service_foundation_grafana_alloy_service_version }}"
    target_label  = "service_version"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project", "__meta_docker_container_label_com_docker_compose_service"]
    separator     = ";"
    regex         = "^nutsnews-app;nutsnews-app$"
    replacement   = "{{ vps_service_foundation_nutsnews_app_source_commit | default('unknown', true) }}"
    target_label  = "service_version"
  }

  rule {
    target_label = "job"
    replacement  = "docker"
  }

  rule {
    target_label = "log_source"
    replacement  = "docker"
  }

  rule {
    target_label = "source"
    replacement  = "docker"
  }

  rule {
    action = "labeldrop"
    regex  = "^(__meta_docker_container_id|__meta_docker_container_label_com_docker_compose_config_hash|__meta_docker_network_id|__meta_docker_port_.*)$"
  }
}

loki.source.docker "containers" {
  host             = "{{ vps_service_foundation_grafana_alloy_docker_socket }}"
  targets          = discovery.relabel.docker_logs.output
  labels           = {log_source = "docker", source = "docker"}
  refresh_interval = "60s"
  forward_to       = [loki.process.docker.receiver]
}

loki.process "docker" {
  forward_to = [loki.write.grafana_cloud.receiver]

  stage.json {
    expressions = {
      timestamp            = "timestamp",
      ts                   = "ts",
      level                = "level",
      parsed_severity      = "severity",
      component            = "component",
      request_id           = "request_id",
      message_id           = "message_id",
      correlation_id       = "correlation_id",
      traceparent          = "traceparent",
      trace_id             = "trace_id",
      article_id           = "article_id",
      feed_id              = "feed_id",
      idempotency_key      = "idempotency_key",
      method               = "method",
      request_method       = "request.method",
      status               = "status",
      path                 = "path",
      uri                  = "request.uri",
      duration_ms          = "duration_ms",
      duration             = "duration",
      caddy_logger         = "logger",
      caddy_request_host   = "request.host",
      caddy_request_proto  = "request.proto",
    }
    drop_malformed = false
  }

  stage.template {
    source   = "severity"
{% raw %}
    template = "{{ if .parsed_severity }}{{ ToLower .parsed_severity }}{{ else if .level }}{{ ToLower .level }}{{ else }}unknown{{ end }}"
{% endraw %}

  }

  stage.template {
    source   = "severity"
{% raw %}
    template = "{{ $s := .Value }}{{ if or (eq $s \"trace\") (eq $s \"debug\") }}debug{{ else if or (eq $s \"info\") (eq $s \"notice\") }}info{{ else if or (eq $s \"warn\") (eq $s \"warning\") }}warning{{ else if or (eq $s \"err\") (eq $s \"error\") }}error{{ else if or (eq $s \"fatal\") (eq $s \"critical\") (eq $s \"crit\") (eq $s \"alert\") (eq $s \"emerg\") (eq $s \"emergency\") }}critical{{ else }}unknown{{ end }}"
{% endraw %}
  }

  stage.labels {
    values = {
      severity = "",
    }
  }

  stage.replace {
    source     = "path"
    expression = "(\\?.*)"
    replace    = ""
  }

  stage.replace {
    source     = "uri"
    expression = "(\\?.*)"
    replace    = ""
  }

  stage.structured_metadata {
    values = {
      timestamp            = "",
      ts                   = "",
      component            = "",
      request_id           = "",
      message_id           = "",
      correlation_id       = "",
      traceparent          = "",
      trace_id             = "",
      article_id           = "",
      feed_id              = "",
      idempotency_key      = "",
      method               = "",
      request_method       = "",
      status               = "",
      path                 = "",
      uri                  = "",
      duration_ms          = "",
      duration             = "",
      caddy_logger         = "",
      caddy_request_host   = "",
      caddy_request_proto  = "",
    }
  }

  stage.replace {
    expression = "(?i)bearer\\s+([A-Za-z0-9._~+/=-]+)"
    replace    = "[redacted]"
  }

  stage.replace {
    expression = "(?i)(?:password|passwd|token|secret|authorization|proxy[_-]?authorization|credential|api[_-]?key|x[_-]?api[_-]?key)[\"']?\\s*[:=]\\s*(\\[[^\\]]*\\])"
    replace    = "[\\\"[redacted]\\\"]"
  }

  stage.replace {
    expression = "(?i)(?:password|passwd|token|secret|authorization|proxy[_-]?authorization|credential|api[_-]?key|x[_-]?api[_-]?key)[\"']?\\s*[:=]\\s*[\"']([^\"']*)"
    replace    = "[redacted]"
  }

  stage.replace {
    expression = "(?i)(?:authorization|proxy[_-]?authorization)[\"']?\\s*[:=]\\s*(?:basic|digest|bearer|token)\\s+([^\\s,}\\]]+)"
    replace    = "[redacted]"
  }

  stage.replace {
    expression = "(?i)(?:password|passwd|token|secret|authorization|proxy[_-]?authorization|credential|api[_-]?key|x[_-]?api[_-]?key)=([^\\s,]+)"
    replace    = "[redacted]"
  }

  stage.replace {
    expression = "(?i)(?:password|passwd|token|secret|authorization|proxy[_-]?authorization|credential|api[_-]?key|x[_-]?api[_-]?key)\\s*:\\s*([^,\\s]+)"
    replace    = "[redacted]"
  }

  stage.replace {
    expression = "(\\?[^\"\\s]*)"
    replace    = "?[query-redacted]"
  }

  stage.replace {
    expression = "((?:[0-9]{1,3}\\.){3}[0-9]{1,3})"
    replace    = "[ip]"
  }

  stage.match {
    selector            = "{severity=\"debug\"}"
    action              = "drop"
    drop_counter_reason = "docker_debug"
  }

  stage.drop {
    longer_than         = "8KB"
    drop_counter_reason = "docker_line_too_large"
  }

  stage.limit {
    rate                = {{ vps_service_foundation_grafana_alloy_docker_log_rate }}
    burst               = {{ vps_service_foundation_grafana_alloy_docker_log_burst }}
    drop                = true
    by_label_name       = "service"
    max_distinct_labels = 3
  }

  stage.label_keep {
    values = ["deployment_environment", "service", "service_version", "host", "source", "severity"]
  }
}
{% endif %}
