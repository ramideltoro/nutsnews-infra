{
  "schemaVersion": 1,
  "sourceFolderUid": "integration---linux-node",
  "destinationFolderUid": "nutsnews-observability",
  "groupName": "NutsNews Linux integration alert replacements",
  "intervalSeconds": 60,
  "sourceIntegrationVersion": "1.6.2",
  "rules": [
    {
      "sourceUid": "455a9775-1dae-5313-9593-ee5770c75127",
      "replacementUid": "nn-linux-455a9775-1da",
      "sourceGroup": "node-exporter",
      "title": "NodeCPUHighUsage",
      "sourceSeverity": "info",
      "normalizedSeverity": "low",
      "condition": "threshold",
      "for": "15m",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "sum without(mode) (avg without (cpu) (rate(node_cpu_seconds_total{job=~\"integrations/(node_exporter|unix)\", mode!~\"idle|iowait\"}[2m]))) * 100 > 90\n",
      "summary": "High CPU usage.",
      "description": "CPU usage at {{ $labels.instance }} has been above 90% for the last 15 minutes, is currently at {{ printf \"%.2f\" $value }}%.\nNote that 'iowait' CPU mode is excluded from total utilization.\n"
    },
    {
      "sourceUid": "0bf4c9fa-6632-5abd-a459-974283f2a548",
      "replacementUid": "nn-linux-0bf4c9fa-663",
      "sourceGroup": "node-exporter",
      "title": "NodeClockNotSynchronising",
      "sourceSeverity": "warning",
      "normalizedSeverity": "warning",
      "condition": "threshold",
      "for": "10m",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "min_over_time(node_timex_sync_status{job=~\"integrations/(node_exporter|unix)\"}[5m]) == 0\nand\nnode_timex_maxerror_seconds{job=~\"integrations/(node_exporter|unix)\"} >= 16\n",
      "summary": "Clock not synchronising.",
      "description": "Clock at {{ $labels.instance }} is not synchronising. Ensure NTP is configured on this host."
    },
    {
      "sourceUid": "bfe6750a-0e6f-57e0-a02c-eddae7a9bfb7",
      "replacementUid": "nn-linux-bfe6750a-0e6",
      "sourceGroup": "node-exporter",
      "title": "NodeClockSkewDetected",
      "sourceSeverity": "warning",
      "normalizedSeverity": "warning",
      "condition": "threshold",
      "for": "10m",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "(\n  node_timex_offset_seconds{job=~\"integrations/(node_exporter|unix)\"} > 0.05\nand\n  deriv(node_timex_offset_seconds{job=~\"integrations/(node_exporter|unix)\"}[5m]) >= 0\n)\nor\n(\n  node_timex_offset_seconds{job=~\"integrations/(node_exporter|unix)\"} < -0.05\nand\n  deriv(node_timex_offset_seconds{job=~\"integrations/(node_exporter|unix)\"}[5m]) <= 0\n)\n",
      "summary": "Clock skew detected.",
      "description": "Clock at {{ $labels.instance }} is out of sync by more than 0.05s. Ensure NTP is configured correctly on this host."
    },
    {
      "sourceUid": "272e1d53-43d3-5428-a6b3-f8af8480b284",
      "replacementUid": "nn-linux-272e1d53-43d",
      "sourceGroup": "node-exporter",
      "title": "NodeDiskIOSaturation",
      "sourceSeverity": "warning",
      "normalizedSeverity": "warning",
      "condition": "threshold",
      "for": "30m",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "rate(node_disk_io_time_weighted_seconds_total{job=~\"integrations/(node_exporter|unix)\", device!=\"\"}[5m]) > 10\n",
      "summary": "Disk IO queue is high.",
      "description": "Disk IO queue (aqu-sq) is high on {{ $labels.device }} at {{ $labels.instance }}, has been above 10 for the last 30 minutes, is currently at {{ printf \"%.2f\" $value }}.\nThis symptom might indicate disk saturation.\n"
    },
    {
      "sourceUid": "a2870d8a-021d-5592-95e8-142e5efdc72d",
      "replacementUid": "nn-linux-a2870d8a-021",
      "sourceGroup": "node-exporter",
      "title": "NodeFileDescriptorLimit",
      "sourceSeverity": "warning",
      "normalizedSeverity": "warning",
      "condition": "threshold",
      "for": "15m",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "(\n  node_filefd_allocated{job=~\"integrations/(node_exporter|unix)\"} * 100 / node_filefd_maximum{job=~\"integrations/(node_exporter|unix)\"} > 70\n)\n",
      "summary": "Kernel is predicted to exhaust file descriptors limit soon.",
      "description": "File descriptors limit at {{ $labels.instance }} is currently at {{ printf \"%.2f\" $value }}%."
    },
    {
      "sourceUid": "1a0f8c06-c2cb-5059-be18-9e44eaf7c2a4",
      "replacementUid": "nn-linux-1a0f8c06-c2c",
      "sourceGroup": "node-exporter",
      "title": "NodeHasRebooted",
      "sourceSeverity": "info",
      "normalizedSeverity": "low",
      "condition": "threshold",
      "for": "0s",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "(time() - node_boot_time_seconds{job=~\"integrations/(node_exporter|unix)\"}) < 600\nand\n(time() - (node_boot_time_seconds{job=~\"integrations/(node_exporter|unix)\"} offset 10m)) > 600\n",
      "summary": "Node has rebooted.",
      "description": "Node {{ $labels.instance }} has rebooted {{ $value | humanize }} seconds ago."
    },
    {
      "sourceUid": "6e5718d7-1dc4-5489-ac3f-251162cf0336",
      "replacementUid": "nn-linux-6e5718d7-1dc",
      "sourceGroup": "node-exporter",
      "title": "NodeHighNumberConntrackEntriesUsed",
      "sourceSeverity": "warning",
      "normalizedSeverity": "warning",
      "condition": "threshold",
      "for": "0s",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "(node_nf_conntrack_entries{job=~\"integrations/(node_exporter|unix)\"} / node_nf_conntrack_entries_limit) > 0.75\n",
      "summary": "Number of conntrack are getting close to the limit.",
      "description": "{{ $labels.instance }} {{ $value | humanizePercentage }} of conntrack entries are used."
    },
    {
      "sourceUid": "edfaf3f2-7666-5ede-8f74-f839e2c94ef0",
      "replacementUid": "nn-linux-edfaf3f2-766",
      "sourceGroup": "node-exporter",
      "title": "NodeMemoryHighUtilization",
      "sourceSeverity": "warning",
      "normalizedSeverity": "warning",
      "condition": "threshold",
      "for": "15m",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "100 - (node_memory_MemAvailable_bytes{job=~\"integrations/(node_exporter|unix)\"} / node_memory_MemTotal_bytes{job=~\"integrations/(node_exporter|unix)\"} * 100) > 90\n",
      "summary": "Host is running out of memory.",
      "description": "Memory is filling up at {{ $labels.instance }}, has been above 90% for the last 15 minutes, is currently at {{ printf \"%.2f\" $value }}%.\n"
    },
    {
      "sourceUid": "f2687789-ec6e-5955-8f37-307af559e79c",
      "replacementUid": "nn-linux-f2687789-ec6",
      "sourceGroup": "node-exporter",
      "title": "NodeMemoryMajorPagesFaults",
      "sourceSeverity": "warning",
      "normalizedSeverity": "warning",
      "condition": "threshold",
      "for": "15m",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "rate(node_vmstat_pgmajfault{job=~\"integrations/(node_exporter|unix)\"}[5m]) > 500\n",
      "summary": "Memory major page faults are occurring at very high rate.",
      "description": "Memory major pages are occurring at very high rate at {{ $labels.instance }}, 500 major page faults per second for the last 15 minutes, is currently at {{ printf \"%.2f\" $value }}.\nPlease check that there is enough memory available at this instance.\n"
    },
    {
      "sourceUid": "7220f375-7b9c-52bf-8d96-9f7fb215b68b",
      "replacementUid": "nn-linux-7220f375-7b9",
      "sourceGroup": "node-exporter",
      "title": "NodeNetworkReceiveErrs",
      "sourceSeverity": "warning",
      "normalizedSeverity": "warning",
      "condition": "threshold",
      "for": "1h",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "rate(node_network_receive_errs_total{job=~\"integrations/(node_exporter|unix)\"}[2m]) / rate(node_network_receive_packets_total{job=~\"integrations/(node_exporter|unix)\"}[2m]) > 0.01\n",
      "summary": "Network interface is reporting many receive errors.",
      "description": "{{ $labels.instance }} interface {{ $labels.device }} has encountered {{ printf \"%.0f\" $value }} receive errors in the last two minutes."
    },
    {
      "sourceUid": "8e24e771-d9b6-5e34-ad66-2c06a3177881",
      "replacementUid": "nn-linux-8e24e771-d9b",
      "sourceGroup": "node-exporter",
      "title": "NodeNetworkTransmitErrs",
      "sourceSeverity": "warning",
      "normalizedSeverity": "warning",
      "condition": "threshold",
      "for": "1h",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "rate(node_network_transmit_errs_total{job=~\"integrations/(node_exporter|unix)\"}[2m]) / rate(node_network_transmit_packets_total{job=~\"integrations/(node_exporter|unix)\"}[2m]) > 0.01\n",
      "summary": "Network interface is reporting many transmit errors.",
      "description": "{{ $labels.instance }} interface {{ $labels.device }} has encountered {{ printf \"%.0f\" $value }} transmit errors in the last two minutes."
    },
    {
      "sourceUid": "f93e66c9-11a9-5831-822e-990364a12138",
      "replacementUid": "nn-linux-f93e66c9-11a",
      "sourceGroup": "node-exporter",
      "title": "NodeProcessesCountIsHigh",
      "sourceSeverity": "warning",
      "normalizedSeverity": "warning",
      "condition": "threshold",
      "for": "5m",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "node_procs_running{job=~\"integrations/(node_exporter|unix)\"} > 400\n",
      "summary": "There is more than 400 running processes on host.",
      "description": "There is {{ $value }} running processes on {{ $labels.instance }}."
    },
    {
      "sourceUid": "1b8c642f-6e02-5549-a9e4-13f8db71c47d",
      "replacementUid": "nn-linux-1b8c642f-6e0",
      "sourceGroup": "node-exporter",
      "title": "NodeRAIDDegraded",
      "sourceSeverity": "critical",
      "normalizedSeverity": "critical",
      "condition": "threshold",
      "for": "15m",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "node_md_disks_required{job=~\"integrations/(node_exporter|unix)\",device!=\"\"} - ignoring (state) (node_md_disks{state=\"active\",job=~\"integrations/(node_exporter|unix)\",device!=\"\"}) > 0\n",
      "summary": "RAID Array is degraded.",
      "description": "RAID array '{{ $labels.device }}' at {{ $labels.instance }} is in degraded state due to one or more disks failures. Number of spare drives is insufficient to fix issue automatically."
    },
    {
      "sourceUid": "9c5cc980-fb75-5b12-aedc-7f6073217982",
      "replacementUid": "nn-linux-9c5cc980-fb7",
      "sourceGroup": "node-exporter",
      "title": "NodeRAIDDiskFailure",
      "sourceSeverity": "warning",
      "normalizedSeverity": "warning",
      "condition": "threshold",
      "for": "0s",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "node_md_disks{state=\"failed\",job=~\"integrations/(node_exporter|unix)\",device!=\"\"} > 0\n",
      "summary": "Failed device in RAID array.",
      "description": "At least one device in RAID array at {{ $labels.instance }} failed. Array '{{ $labels.device }}' needs attention and possibly a disk swap."
    },
    {
      "sourceUid": "aaa02146-aa1d-5bad-ad7d-3373b0b5447a",
      "replacementUid": "nn-linux-aaa02146-aa1",
      "sourceGroup": "node-exporter",
      "title": "NodeSystemSaturation",
      "sourceSeverity": "warning",
      "normalizedSeverity": "warning",
      "condition": "threshold",
      "for": "15m",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "node_load1{job=~\"integrations/(node_exporter|unix)\"}\n/ count without (cpu, mode) (node_cpu_seconds_total{job=~\"integrations/(node_exporter|unix)\", mode=\"idle\"}) > 2\n",
      "summary": "System saturated, load per core is very high.",
      "description": "System load per core at {{ $labels.instance }} has been above 2 for the last 15 minutes, is currently at {{ printf \"%.2f\" $value }}.\nThis might indicate this instance resources saturation and can cause it becoming unresponsive.\n"
    },
    {
      "sourceUid": "0160fb80-7873-506d-af67-dd6a94878344",
      "replacementUid": "nn-linux-0160fb80-787",
      "sourceGroup": "node-exporter",
      "title": "NodeSystemdServiceCrashlooping",
      "sourceSeverity": "warning",
      "normalizedSeverity": "warning",
      "condition": "threshold",
      "for": "15m",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "increase(node_systemd_service_restart_total{job=~\"integrations/(node_exporter|unix)\"}[5m]) > 2\n",
      "summary": "Systemd service keeps restaring, possibly crash looping.",
      "description": "Systemd service {{ $labels.name }} has been restarted too many times at {{ $labels.instance }} for the last 15 minutes. Please check if service is crash looping."
    },
    {
      "sourceUid": "eb5f628f-be95-5b1c-be2f-b8c216a7e029",
      "replacementUid": "nn-linux-eb5f628f-be9",
      "sourceGroup": "node-exporter",
      "title": "NodeSystemdServiceFailed",
      "sourceSeverity": "warning",
      "normalizedSeverity": "warning",
      "condition": "threshold",
      "for": "5m",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "node_systemd_unit_state{job=~\"integrations/(node_exporter|unix)\", state=\"failed\"} == 1\n",
      "summary": "Systemd service has entered failed state.",
      "description": "Systemd service {{ $labels.name }} has entered failed state at {{ $labels.instance }}.\nIf this service is not required anymore, remove it or run `systemctl reset-failed {{ $labels.name }}` in order to reset the failed counter.\n"
    },
    {
      "sourceUid": "e643033c-eb08-57ce-9744-80532cf7d521",
      "replacementUid": "nn-linux-e643033c-eb0",
      "sourceGroup": "node-exporter",
      "title": "NodeTextFileCollectorScrapeError",
      "sourceSeverity": "warning",
      "normalizedSeverity": "warning",
      "condition": "threshold",
      "for": "0s",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "node_textfile_scrape_error{job=~\"integrations/(node_exporter|unix)\"} == 1\n",
      "summary": "Node Exporter text file collector failed to scrape.",
      "description": "Node Exporter text file collector on {{ $labels.instance }} failed to scrape."
    },
    {
      "sourceUid": "a3455147-f220-53f4-8261-8551a6e86d17",
      "replacementUid": "nn-linux-a3455147-f22",
      "sourceGroup": "node-exporter-filesystem",
      "title": "NodeFilesystemAlmostOutOfFiles",
      "sourceSeverity": "critical",
      "normalizedSeverity": "critical",
      "condition": "threshold",
      "for": "1h",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "(\n  node_filesystem_files_free{job=~\"integrations/(node_exporter|unix)\",fstype!=\"\",mountpoint!=\"\"} / node_filesystem_files{job=~\"integrations/(node_exporter|unix)\",fstype!=\"\",mountpoint!=\"\"} * 100 < 3\nand\n  node_filesystem_readonly{job=~\"integrations/(node_exporter|unix)\",fstype!=\"\",mountpoint!=\"\"} == 0\n)\n",
      "summary": "Filesystem has less than 3% inodes left.",
      "description": "Filesystem on {{ $labels.device }}, mounted on {{ $labels.mountpoint }}, at {{ $labels.instance }} has only {{ printf \"%.2f\" $value }}% available inodes left."
    },
    {
      "sourceUid": "bbf5608b-b69e-58e7-b102-1bc5df13af0d",
      "replacementUid": "nn-linux-bbf5608b-b69",
      "sourceGroup": "node-exporter-filesystem",
      "title": "NodeFilesystemAlmostOutOfFiles",
      "sourceSeverity": "warning",
      "normalizedSeverity": "warning",
      "condition": "threshold",
      "for": "1h",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "(\n  node_filesystem_files_free{job=~\"integrations/(node_exporter|unix)\",fstype!=\"\",mountpoint!=\"\"} / node_filesystem_files{job=~\"integrations/(node_exporter|unix)\",fstype!=\"\",mountpoint!=\"\"} * 100 < 5\nand\n  node_filesystem_readonly{job=~\"integrations/(node_exporter|unix)\",fstype!=\"\",mountpoint!=\"\"} == 0\n)\n",
      "summary": "Filesystem has less than 5% inodes left.",
      "description": "Filesystem on {{ $labels.device }}, mounted on {{ $labels.mountpoint }}, at {{ $labels.instance }} has only {{ printf \"%.2f\" $value }}% available inodes left."
    },
    {
      "sourceUid": "3363e973-98e8-5d7e-a3b8-8bf7c1d49752",
      "replacementUid": "nn-linux-3363e973-98e",
      "sourceGroup": "node-exporter-filesystem",
      "title": "NodeFilesystemAlmostOutOfSpace",
      "sourceSeverity": "warning",
      "normalizedSeverity": "warning",
      "condition": "threshold",
      "for": "30m",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "(\n  node_filesystem_avail_bytes{job=~\"integrations/(node_exporter|unix)\",fstype!=\"\",mountpoint!=\"\"} / node_filesystem_size_bytes{job=~\"integrations/(node_exporter|unix)\",fstype!=\"\",mountpoint!=\"\"} * 100 < 5\nand\n  node_filesystem_readonly{job=~\"integrations/(node_exporter|unix)\",fstype!=\"\",mountpoint!=\"\"} == 0\n)\n",
      "summary": "Filesystem has less than 5% space left.",
      "description": "Filesystem on {{ $labels.device }}, mounted on {{ $labels.mountpoint }}, at {{ $labels.instance }} has only {{ printf \"%.2f\" $value }}% available space left."
    },
    {
      "sourceUid": "c9f53ea6-643b-57e5-ac9c-7b665f9bfd05",
      "replacementUid": "nn-linux-c9f53ea6-643",
      "sourceGroup": "node-exporter-filesystem",
      "title": "NodeFilesystemAlmostOutOfSpace",
      "sourceSeverity": "critical",
      "normalizedSeverity": "critical",
      "condition": "threshold",
      "for": "30m",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "(\n  node_filesystem_avail_bytes{job=~\"integrations/(node_exporter|unix)\",fstype!=\"\",mountpoint!=\"\"} / node_filesystem_size_bytes{job=~\"integrations/(node_exporter|unix)\",fstype!=\"\",mountpoint!=\"\"} * 100 < 3\nand\n  node_filesystem_readonly{job=~\"integrations/(node_exporter|unix)\",fstype!=\"\",mountpoint!=\"\"} == 0\n)\n",
      "summary": "Filesystem has less than 3% space left.",
      "description": "Filesystem on {{ $labels.device }}, mounted on {{ $labels.mountpoint }}, at {{ $labels.instance }} has only {{ printf \"%.2f\" $value }}% available space left."
    },
    {
      "sourceUid": "3aaba02e-f615-5511-b01d-3ddae0bfb177",
      "replacementUid": "nn-linux-3aaba02e-f61",
      "sourceGroup": "node-exporter-filesystem",
      "title": "NodeFilesystemFilesFillingUp",
      "sourceSeverity": "critical",
      "normalizedSeverity": "critical",
      "condition": "threshold",
      "for": "1h",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "(\n  node_filesystem_files_free{job=~\"integrations/(node_exporter|unix)\",fstype!=\"\",mountpoint!=\"\"} / node_filesystem_files{job=~\"integrations/(node_exporter|unix)\",fstype!=\"\",mountpoint!=\"\"} * 100 < 20\nand\n  predict_linear(node_filesystem_files_free{job=~\"integrations/(node_exporter|unix)\",fstype!=\"\",mountpoint!=\"\"}[6h], 4*60*60) < 0\nand\n  node_filesystem_readonly{job=~\"integrations/(node_exporter|unix)\",fstype!=\"\",mountpoint!=\"\"} == 0\n)\n",
      "summary": "Filesystem is predicted to run out of inodes within the next 4 hours.",
      "description": "Filesystem on {{ $labels.device }}, mounted on {{ $labels.mountpoint }}, at {{ $labels.instance }} has only {{ printf \"%.2f\" $value }}% available inodes left and is filling up fast."
    },
    {
      "sourceUid": "5b082cee-4c7f-5d52-8143-e83d6341a9c2",
      "replacementUid": "nn-linux-5b082cee-4c7",
      "sourceGroup": "node-exporter-filesystem",
      "title": "NodeFilesystemFilesFillingUp",
      "sourceSeverity": "warning",
      "normalizedSeverity": "warning",
      "condition": "threshold",
      "for": "1h",
      "noDataState": "OK",
      "execErrState": "OK",
      "queryFrom": 660,
      "queryTo": 60,
      "expr": "(\n  node_filesystem_files_free{job=~\"integrations/(node_exporter|unix)\",fstype!=\"\",mountpoint!=\"\"} / node_filesystem_files{job=~\"integrations/(node_exporter|unix)\",fstype!=\"\",mountpoint!=\"\"} * 100 < 40\nand\n  predict_linear(node_filesystem_files_free{job=~\"integrations/(node_exporter|unix)\",fstype!=\"\",mountpoint!=\"\"}[6h], 24*60*60) < 0\nand\n  node_filesystem_readonly{job=~\"integrations/(node_exporter|unix)\",fstype!=\"\",mountpoint!=\"\"} == 0\n)\n",
      "summary": "Filesystem is predicted to run out of inodes within the next 24 hours.",
      "description": "Filesystem on {{ $labels.device }}, mounted on {{ $labels.mountpoint }}, at {{ $labels.instance }} has only {{ printf \"%.2f\" $value }}% available inodes left and is filling up."
    }
  ]
}
